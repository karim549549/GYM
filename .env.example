# Supabase project "gym" (ref ysspiqljkznmoxyababa), Connect button in the dashboard.
# App runtime: transaction pooler, port 6543.
DATABASE_URL=postgresql://gym_backend.ysspiqljkznmoxyababa:<password>@aws-1-eu-central-1.pooler.supabase.com:6543/postgres
# Migrations: direct or session pooler, port 5432.
DIRECT_URL=postgresql://gym_backend.ysspiqljkznmoxyababa:<password>@aws-1-eu-central-1.pooler.supabase.com:5432/postgres
PORT=3000
SUPABASE_URL=https://<project-ref>.supabase.co
# Public by design (Supabase dashboard > API keys). The backend uses it to call Supabase Auth.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>

# Secret key (Supabase dashboard > API keys > Secret keys). Bypasses all access rules:
# the backend uses it for Storage only. Never commit it, never send it to a client.
SUPABASE_SECRET_KEY=sb_secret_<key>

# Dashboard > Authentication > Hooks > Send SMS: the signing secret (v1,whsec_...). Needed in production.
# SUPABASE_HOOK_SECRET=v1,whsec_<base64>

# 'mock' prints WhatsApp messages (codes included) to the console instead of sending them.
# Development and tests only: the app refuses to start in production with the mock.
WHATSAPP_PROVIDER=mock

# Where the web app lives; intake links are <this>/f/<token>. Required in production.
# PUBLIC_APP_URL=https://app.example.com

# Seconds between looks for due reminders (0 = off). Defaults to 60.
# REMINDER_POLL_SECONDS=60

# Seconds between top-ups of the next month of check-ins (0 = off). Defaults to 3600.
# CHECKIN_TOPUP_SECONDS=3600
